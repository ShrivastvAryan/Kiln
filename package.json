{
  "name": "deployx",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local-first auto-deployment platform: clone, build and serve Git repositories on wildcard subdomains.",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "cd apps/dashboard && npm run dev",
    "dev:all": "concurrently -k -n api,worker,router,web -c cyan,magenta,yellow,green \"npm:dev:api\" \"npm:dev:worker\" \"npm:dev:router\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w @deployx/api",
    "dev:worker": "npm run dev -w @deployx/worker",
    "dev:router": "npm run dev -w @deployx/router",
    "dev:web": "cd apps/dashboard && npm run dev",
    "services:up": "docker compose up -d --build",
    "services:down": "docker compose down",
    "services:logs": "docker compose logs -f api worker router",
    "services:rebuild": "docker compose up -d --build --force-recreate api worker router",
    "infra:up": "docker compose up -d redis seaweedfs",
    "infra:down": "docker compose stop redis seaweedfs",
    "start": "concurrently -k -n api,worker,router,web -c cyan,magenta,yellow,green \"npm start -w @deployx/api\" \"npm start -w @deployx/worker\" \"npm start -w @deployx/router\" \"npm start -w @deployx/dashboard\"",
    "build": "npm run build -w @deployx/dashboard",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck -w @deployx/dashboard",
    "db:generate": "prisma generate --schema packages/shared/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema packages/shared/prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema packages/shared/prisma/schema.prisma",
    "db:studio": "prisma studio --schema packages/shared/prisma/schema.prisma",
    "postinstall": "prisma generate --schema packages/shared/prisma/schema.prisma"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "prisma": "^6.19.3"
  },
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "@neon/config": "^1.14.3",
    "@neon/env": "^2.1.6"
  }
}
