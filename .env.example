# ── Core ──────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379
ROOT_DOMAIN=localhost          # deployments are served at http://<id>.<ROOT_DOMAIN>:<ROUTER_PORT>
API_PORT=8000                  # backend REST + SSE (the Next.js console runs on :3000)
ROUTER_PORT=3001

# ── PostgreSQL (source of truth) ──────────────────────
# Local (docker compose):  postgresql://deployx:deployx@127.0.0.1:5432/deployx
# Neon: DATABASE_URL = the *pooled* string (host contains "-pooler"), DIRECT_URL = the direct string.
#       Both need ?sslmode=require
DATABASE_URL=postgresql://deployx:deployx@127.0.0.1:5432/deployx
DIRECT_URL=postgresql://deployx:deployx@127.0.0.1:5432/deployx

# ── Object storage ────────────────────────────────────
STORAGE_DRIVER=s3              # s3 (MinIO / AWS S3 / R2) | fs (local disk, no Docker needed)
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=deployx
S3_SECRET_KEY=deployx-secret
S3_BUCKET=deployx
FS_STORAGE_DIR=.data/storage

# ── Build workers ─────────────────────────────────────
WORKER_CONCURRENCY=2           # parallel builds per worker process
BUILD_ISOLATION=docker         # docker (sandboxed container) | local (host process, trusted repos only)
BUILD_IMAGE=node:22-alpine
BUILD_TIMEOUT_MS=600000
BUILD_MEMORY=1g
BUILD_CPUS=1.5
