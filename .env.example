# Copy to .env (git-ignored). Docker Compose reads it for the ${...} values in docker-compose.yml.

# ── Neon Postgres ─────────────────────────────────────
# Filled in by `neon env pull` (or `neon deploy`) after `neon login`.
# DATABASE_URL = pooled "-pooler" host (app queries) · DATABASE_URL_UNPOOLED = direct host (migrations)
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# ── Object storage (SeaweedFS container, S3 API) ──────
# Use URL-safe characters; generate with: openssl rand -hex 24
S3_ACCESS_KEY=kiln
S3_SECRET_KEY=change-me-s3-secret-key
S3_BUCKET=deployx

# ── Auth ──────────────────────────────────────────────
# Signs the 15-minute access tokens. At least 32 random characters: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-generate-with-openssl-rand-base64-48
# Google sign-in (optional; the button appears once both are set). Create an OAuth client
# (Web application) at https://console.cloud.google.com/apis/credentials with redirect URI:
#   http://localhost:8000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── GitHub App (optional; "Connect GitHub" appears once all five are set) ──
# Create at https://github.com/settings/apps/new. Callback URL: http://localhost:8000/api/github/callback
# Setup URL: http://localhost:8000/api/github/setup. Permissions: Contents (read-only), Metadata (read-only).
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# The downloaded .pem, base64-encoded on one line:  base64 -w0 your-app.private-key.pem
GITHUB_APP_PRIVATE_KEY=
